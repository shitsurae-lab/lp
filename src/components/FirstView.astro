---
import Container from "./Container.astro";
import BubbleOverlay from "./BubbleOverlay.astro";
const pcBgImage = "/images/firstview@2x.webp";
const spBgImage = "/images/firstview--sp.webp";
const watchImage = "/images/pugheuer-firstview@2x.webp";
---

<section class="relative w-full h-svh overflow-hidden bg-slate-950">
  <!-- 1. 背景画像（画面全体に全幅・全高で敷き詰める） -->
  <picture class="absolute inset-0 w-full h-full z-0">
    <source media="(max-width: 767px)" srcset={spBgImage} />
    <source media="(min-width: 768px)" srcset={pcBgImage} />
    <img
      src={pcBgImage}
      alt=""
      class="w-full h-full object-cover block"
      loading="eager"
      decoding="async"
    />
  </picture>
  <!-- 2. 泡のエフェクトレイヤー（中間: z-15 ※BubbleOverlayを使う場合） -->
  <BubbleOverlay />
  <!-- 3. コンテンツ領域（1080px/360pxの枠線を基準にする） -->
  <Container className="relative z-20 h-full">
    <!-- キャッチコピー（Containerの左/右を基準に配置） -->
    <div
      class="absolute text-white text-center md:text-left
             top-[25%] left-1/2 -translate-x-1/2
             md:top-auto md:bottom-[25%] md:left-[50%] md:translate-x-0 lg:left-[55%] 2xl:left-[60%]"
    >
      <p class="text-xs md:text-sm tracking-[0.2em] font-light font-libre opacity-90 mb-2">
        THE CHALLENGER OF THE DEEP
      </p>
      <p class="text-2xl md:text-4xl lg:text-5xl font-zen tracking-widest leading-none">
        深淵に挑む者へ
      </p>
    </div>

    <!-- 時計画像（Containerの底辺を基準に配置） -->
    <div
      class="absolute pointer-events-none
             bottom-0 left-1/2 -translate-x-1/2 w-[80%] max-w-[340px]
             md:bottom-[-5%] md:left-[5%] md:translate-x-0 md:w-[45%] md:max-w-[clamp(360px,30vw,480px)]"
    >
      <img
        src={watchImage}
        alt="PUG HEUER - AQUARACER"
        class="w-full h-auto drop-shadow-2xl block"
        loading="eager"
        decoding="async"
      />
    </div>
  </Container>
</section>
