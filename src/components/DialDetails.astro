---
// src/components/DialDetail.astro
import Container from "./Container.astro";

// 画像パスの定義
const upperImage = "/images/pugheuer-upper.webp";
const lowerhalfImage = "/images/pugheuer-lowerhalf.webp";
const backcoverImage = "/images/pugheuer-backcover.webp";

// 3つのトピックデータ
const details = [
  {
    id: "dial-design",
    title: "ダイヤルデザイン",
    description:
      "ブランドロゴとインデックスのレイアウトを徹底的に見直し、クロノグラフのサブダイヤルと調和するソリッドで開放的なダイヤルデザインを実現。",
    image: upperImage,
    alt: "ダイヤルデザイン（上部ダイヤルとクロノグラフ）",
    reverseOnPc: false,
  },
  {
    id: "hands-indexes",
    title: "見やすくなった針・インデックス",
    description:
      "分針やクロノグラフ針の先端が、目盛り（インデックス）にぴったり届く長さに設計。立体的なインデックスと明るく光る夜光塗料（ルミナス）を組み合わせることで、昼夜を問わず一目で時刻が読み取れる抜群の見やすさを実現しています。",
    image: lowerhalfImage,
    alt: "見やすくなった針・インデックス（下部ダイヤル）",
    reverseOnPc: true,
  },
  {
    id: "case-back",
    title: "ケースバック",
    description:
      "高い水圧や過酷な環境に耐えうる高精度なねじ込み式ステンレススチール裏蓋を採用。中央にはフロンティア精神と挑戦を象徴する宇宙飛行士のモチーフを精緻なエングレービング（彫刻）で表現。",
    image: backcoverImage,
    alt: "宇宙飛行士の刻印が施されたねじ込み式ケースバック",
    reverseOnPc: false,
  },
];
---

<!-- セクション全体：背景色を生成り（#F5F5F7）に設定 -->
<section class="w-full bg-[#F5F5F7] text-slate-900 py-16 md:py-24">
  <Container size="slim">
    <!-- セクションタイトルエリア -->
    <div class="text-center mb-12 md:mb-20">
      <span class="text-xs tracking-[0.2em] font-medium text-slate-800 uppercase mb-1 font-montserrat">
        DIAL & DETAIL
      </span>
      <h2 class="text-lg md:text-xl font-serif tracking-wider leading-relaxed">
        視認性と美学を両立した高精細ダイヤル
      </h2>
    </div>

    <!-- 3つの詳細ブロック（gapを外して市松模様を構成） -->
    <div class="flex flex-col">
      {details.map((item) => (
        <div class="grid grid-cols-1 md:grid-cols-2 items-stretch">
          <!-- テキストグループ（背景を純白にして p-12 を付与） -->
          <!-- items-stretch なので画像の高さとぴったり同等に伸びるよ -->
          <div
            class={`order-2 ${item.reverseOnPc ? "md:order-2" : "md:order-1"} aspect-[4/3] bg-white p-6 md:p-12 flex flex-col justify-center`}
          >
            <h3 class="text-lg font-serif tracking-wide leading-relaxed mb-3 md:mb-4">
              {item.title}
            </h3>
            <p class="text-sm leading-relaxed text-slate-700 tracking-wide font-light">
              {item.description}
            </p>
          </div>

          <!-- 画像グループ（画像のスキマや角丸を解消してぴったり接続） -->
          <div
            class={`order-1 ${item.reverseOnPc ? "md:order-1" : "md:order-2"} flex justify-center items-center overflow-hidden`}
          >
            <img
              src={item.image}
              alt={item.alt}
              class="w-full h-full object-cover block"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>
