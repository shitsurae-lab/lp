---
import Container from "./Container.astro";

//時計モデルの配列
const products = [
  {
    id: "DBGX520",
    name: "DBGX520",
    price: "550,000円 + 税",
    image: "./images/bucciarati@2x.webp",
    alt: "PUG HEUER | AQUARACER DBGX520",
    href: "#", //ECサイト未実装のため
  },
  {
    id: "DAGX520",
    name: "DAGX520",
    price: "550,000円 + 税",
    image: "./images/abbacchio@2x.webp",
    alt: "PUG HEUER | AQUARACER DAGX520",
    href: "#", //ECサイト未実装のため
  },
  {
    id: "DFGX520",
    name: "DFGX520",
    price: "550,000円 + 税",
    image: "./images/fugo@2x.webp",
    alt: "PUG HEUER | AQUARACER DFGX520",
    href: "#", //ECサイト未実装のため
  },
];
---

<section class="w-full bg-[#050B14] text-slate-300 py-16 md:py-24">
  <Container size="slim">
    <!-- セクションタイトルエリア -->
    <div class="text-center mb-12 md:mb-20">
      <span class="text-xs tracking-[0.2em] font-sans uppercase block mb-1">
        LINEUP
      </span>
      <h2 class="text-lg md:text-xl font-serif tracking-wider leading-relaxed">
        ジルコニア・セラミックスの特性を最大限に活かした外装デザイン
      </h2>
    </div>
    <!-- アイテムカードグリッド（SP: 1列 / PC: 3列） -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-30 items-start">
      {products.map((item) => (
        <div class="flex flex-col items-center text-center group">
          <!-- 時計画像コンテナ（ホバー時に少し拡大するアニメーション付き） -->
          <div class="relative w-full aspect-[3/4] max-w-[260px] md:max-w-[280px] mb-6 flex items-center justify-center overflow-hidden">
            <img
              src={item.image}
              alt={item.alt}
              class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105 drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)]"
              loading="lazy"
              decoding="async"
            />
          </div>

          <!-- 型番 -->
          <h3 class="text-sm md:text-base font-medium tracking-widest text-slate-200 mb-1">
            {item.name}
          </h3>

          <!-- 価格 -->
          <p class="text-xs md:text-sm text-slate-400 font-sans tracking-wider mb-5">
            {item.price}
          </p>

          <!-- MORE ボタン（枠線のみのミニマルシャープデザイン） -->
          <a
            href={item.href}
            class="inline-flex items-center justify-center w-[120px] h-[36px] text-xs tracking-[0.15em] text-slate-300 border border-slate-600/80 hover:border-slate-200 hover:text-white hover:bg-white/5 transition-all duration-300 font-sans"
            aria-label={`${item.name} の詳細を見る`}
          >
            MORE
          </a>
        </div>
      ))}
    </div>
  </Container>
</section>
