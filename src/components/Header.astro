  <div class="max-w-7xl mx-auto flex items-between">
    <a href="/" class="inline-block">
    <img src={logoImg} alt="Collections Logo" class="w-20 h-10 md:w-80 md:h-40 object-contain">
    </a>
  </div>
</header>
