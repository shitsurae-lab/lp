---
// src/components/LimitedModel.astro
import BubbleOverlay from "./BubbleOverlay.astro";
import Container from "./Container.astro";

// 画像パスの定義
const bannerImage = "/images/bucciarati-diagonal.webp";
const bgPc = "/images/limited-model@2x.webp";
const bgSp = "/images/limited-model--sp.webp";
const faceImage = "/images/pugheuer-face.webp";
const backImage = "/images/pugheuer-back.webp";
---

<!-- セクション全体（全幅） -->
<section class="w-full text-slate-300 overflow-hidden">
  <!-- ① 全幅の時計バナーエリア（SP: 520px / PC: 360px） -->
  <div class="relative w-full h-[520px] md:h-[360px] overflow-hidden">
    <img
      src={bannerImage}
      alt="PUG HEUER - Dial Detail"
      class="w-full h-full object-cover object-center block blur-[2px] scale-105"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/60 pointer-events-none"></div>
  </div>

  <!-- ② 海中の画像 ＆ コンテンツエリア（①の下に連続してスタート） -->
  <div class="relative w-full h-full flex flex-col justify-between">
    <!-- 海中の背景画像（<picture>でPC/SP切り替え） -->
    <picture
      class="rellax absolute inset-0 w-full h-full -z-10"
      data-rellax-speed="-1.5"
    >
      <source media="(max-width: 767px)" srcset={bgSp} />
      <source media="(min-width: 768px)" srcset={bgPc} />
      <img
        src={bgPc}
        alt=""
        class="w-full h-full object-cover object-center block"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <BubbleOverlay />
    <!-- コンテンツ（②のスタート位置から重ねて配置・上下余白 pt-20 / pb-30） -->
    <Container className="relative z-20 w-full pt-20 pb-30">
      <!-- 中見出し + 本文エリア -->
      <div class="text-center mb-16 md:mb-24 max-w-[800px] mx-auto">
        <span class="text-xs tracking-[0.2em] font-medium text-slate-300 uppercase mb-1 font-montserrat">
          LIMITED MODEL
        </span>
        <h2 class="text-xl font-serif tracking-wider leading-relaxed">
          決して戻ることのない「過去」をリプレイ…
          <br class="hidden md:block" />
          美学を宿した特別仕様の限定モデル
        </h2>
      </div>

      <!-- 限定モデル詳細コンテンツ -->
      <div class="flex flex-col gap-40 md:gap-10">
        <!-- BLOCK 1: 表文字盤 -->
        <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] items-center gap-10 md:gap-20">
          <div
            class="rellax order-1 md:order-1 flex justify-center items-center"
            data-rellax-speed="2"
          >
            <img
              src={faceImage}
              alt="アイコニックな「A」のモノグラムとディープパープルダイヤル"
              class="w-full max-w-[300px] md:max-w-[420px] h-auto object-contain drop-shadow-2xl"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="order-2 md:order-2 flex flex-col gap-16">
            <div>
              <h3 class="text-lg font-serif tracking-wide leading-relaxed mb-3 md:mb-4 text-slate-100">
                アイコニックな「A」のモノグラムとディープパープルダイヤル
              </h3>
              <p class="text-sm leading-relaxed md:leading-loose text-slate-300 tracking-wide font-light">
                12時位置には、象徴的な「A」のゴールドエンブレムを厳かに配置。ダイヤルには深く艶やかなディープパープルとブラックのグラデーションを採用し、ミステリアスかつ気品あふれる世界観を表現しています。
              </p>
            </div>
            <div>
              <h3 class="text-lg font-serif tracking-wide leading-relaxed mb-3 md:mb-4 text-slate-100">
                リプレイを体現するインダイヤルグラフィック
              </h3>
              <p class="text-sm leading-relaxed md:leading-loose text-slate-300 tracking-wide font-light">
                クロノグラフのサブダイヤルには、デジタル表示をモチーフにした意匠や精密なメーターグラフィックを配置。「指定された瞬間の刻を鮮明に再現する」というコンセプトを、高精細な文字盤デザインへ昇華させています。
              </p>
            </div>
          </div>
        </div>

        <!-- BLOCK 2: シースルー裏蓋 -->
        <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr] items-center gap-10 md:gap-20">
          <div
            class="rellax order-1 md:order-2 flex justify-center items-center"
            data-rellax-speed="2"
          >
            <img
              src={backImage}
              alt="神秘的なグラフィックが浮かび上がるシースルーバック"
              class="w-full max-w-[300px] md:max-w-[420px] h-auto object-contain drop-shadow-2xl"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="order-2 md:order-1 flex flex-col justify-center">
            <h3 class="text-lg font-serif tracking-wide leading-relaxed mb-3 md:mb-4 text-slate-100">
              神秘的なグラフィックが浮かび上がるシースルーバック
            </h3>
            <p class="text-sm leading-relaxed md:leading-loose text-slate-300 tracking-wide font-light">
              シースルー仕様のサファイアガラス裏ぶたには、モチーフのグラフィックを精細な透過プリントで配置。裏ぶたから覗くムーブメントの規則正しい振動とグラフィックが交錯し、時計の奥深くに潜むストーリーをドラマチックに表現する豪華な特別仕様です。
            </p>
          </div>
        </div>
      </div>
    </Container>
  </div>
</section>
